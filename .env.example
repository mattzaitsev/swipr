# Copy to .env to override. Every value has a default that matches docker-compose.yml.
DATABASE_URL=postgres://swipr:swipr@localhost:5433/swipr
REDIS_URL=redis://localhost:6379
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=swipr-dev-key

API_PORT=4200

# Ingest: how often each crawl task repeats, and how many run in parallel.
INGEST_EVERY_MS=20000
INGEST_CONCURRENCY=2

# Demo connector + mock marketplace (offline stand-in for a real source).
MOCK_SOURCE_PORT=4210
MOCK_SOURCE_URL=http://localhost:4210
DEMO_QUERIES=couch,bike,desk
MOCK_TICK_MS=8000
# Fraction of mock responses that return 429 + Retry-After (exercises the RetryLater path). 0 = off.
MOCK_FAIL_RATE=0
